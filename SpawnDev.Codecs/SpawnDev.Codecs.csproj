<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.0.1</Version>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.Codecs</Title>
		<Authors>LostBeard</Authors>
		<Description>GPU-accelerated, patent-clean codecs for .NET where the codec work runs on the accelerator: images (PNG, JPEG, WebP, GIF, BMP), video (VP8, VP9, AV1 keyframes), audio (Opus encode and decode byte-identical with libopus 1.5.2, Vorbis, FLAC) and compression. One library on every ILGPU backend: WebGPU, WebGL and Wasm in Blazor WebAssembly; CUDA, OpenCL and CPU on the desktop.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.Codecs</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.Codecs.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Codec;Audio;Video;Image;Opus;VP8;VP9;AV1;FLAC;Vorbis;PNG;JPEG;WebP;GIF;Blazor;BlazorWebAssembly;WebGPU;ILGPU;GPU;CrossPlatform</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="SpawnDev.ILGPU" Version="5.4.13" />
	  <PackageReference Include="SpawnDev.EBML" Version="3.0.1" />
	  <!-- ZERO external dependencies past this line. The CPU reference Opus
	       encoder + decoder (which use Concentus) live in
	       SpawnDev.Codecs.References. SpawnDev.Codecs itself ships only
	       SpawnDev.* + Microsoft framework packages. This is the
	       architectural directive Captain locked 2026-05-03 - the GPU
	       library is a pure SpawnDev.ILGPU consumer. -->
	</ItemGroup>

	<ItemGroup>
		<!-- Test project sees internal types so SILK/CELT subsystems can be tested
		     in isolation without polluting the public API. -->
		<InternalsVisibleTo Include="SpawnDev.Codecs.Demo.Shared" />
		<!-- References project hosts the CPU reference encoders + decoders; they
		     need internal types from main (SilkStereoState, SilkResamplerState,
		     etc.) since CPU implementations and GPU primitives share the same
		     state shapes. -->
		<InternalsVisibleTo Include="SpawnDev.Codecs.References" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<SupportedPlatform Include="windows" />
		<SupportedPlatform Include="linux" />
		<SupportedPlatform Include="macos" />
	</ItemGroup>

</Project>
