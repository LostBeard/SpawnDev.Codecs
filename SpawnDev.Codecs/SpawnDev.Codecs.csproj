<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.1.2-local.2</Version>
		<PackageReleaseNotes>1.1.1: lossless WebP writes the same file on every device (integer predictor costs; CUDA, OpenCL NVIDIA and AMD, Velocity, CPU, WebGPU, Wasm); faster WebP (parallel colour analysis, ALPH trial keeps its winner, two-kernel predictor choice, LZ77 copies reused across colour-cache and strategy trials: SpawnGen Save Animated WEBP on an RX 590 -31% vs 1.1.0); AV1 range coder -19% at 1080p; SpawnDev.ILGPU 5.4.40 (Wasm copy fix). Full list: CHANGELOG.md.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.Codecs</Title>
		<Authors>LostBeard</Authors>
		<Description>GPU-accelerated, patent-clean codecs for .NET where the codec work runs on the accelerator: images (PNG, JPEG, WebP, GIF, BMP) and BCn textures, video (VP9 encode with inter frames, a full VP9 decoder, VP8 and AV1 keyframes, MP4 and WebM muxing), audio (Opus encode and decode byte-identical with libopus 1.5.2, Vorbis, FLAC, MP3) and compression (zlib, LZ4, Snappy, GDeflate). One library on every ILGPU backend: WebGPU, WebGL and Wasm in Blazor WebAssembly; CUDA, OpenCL and CPU on the desktop.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.Codecs</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.Codecs.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Codec;Audio;Video;Image;Opus;VP8;VP9;AV1;FLAC;Vorbis;MP3;PNG;JPEG;WebP;GIF;BCn;LZ4;Snappy;WebM;MP4;Blazor;BlazorWebAssembly;WebGPU;ILGPU;GPU;CrossPlatform</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="Assets\icon-128.png" Pack="true" PackagePath="\" />
		<!-- Third-party notices travel with the package (BSD-3-Clause clause 2: binary redistributions reproduce the notice). -->
		<None Include="..\NOTICE.md" Pack="true" PackagePath="\" />
		<None Include="..\ThirdPartyLicenses\*.txt" Pack="true" PackagePath="ThirdPartyLicenses\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="SpawnDev.ILGPU" Version="5.4.40" />
	  <PackageReference Include="SpawnDev.EBML" Version="3.0.1" />
	  <!-- ZERO external dependencies past this line. The CPU reference Opus
	       encoder + decoder (which use Concentus) live in
	       SpawnDev.Codecs.References. SpawnDev.Codecs itself ships only
	       SpawnDev.* + Microsoft framework packages. This is the
	       architectural directive Captain locked 2026-05-03 - the GPU
	       library is a pure SpawnDev.ILGPU consumer. -->
	</ItemGroup>

	<ItemGroup>
		<!-- Test project sees internal types so SILK/CELT subsystems can be tested
		     in isolation without polluting the public API. -->
		<InternalsVisibleTo Include="SpawnDev.Codecs.Demo.Shared" />
		<InternalsVisibleTo Include="SpawnDev.Codecs.DemoConsole" />
		<!-- References project hosts the CPU reference encoders + decoders; they
		     need internal types from main (SilkStereoState, SilkResamplerState,
		     etc.) since CPU implementations and GPU primitives share the same
		     state shapes. -->
		<InternalsVisibleTo Include="SpawnDev.Codecs.References" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<SupportedPlatform Include="windows" />
		<SupportedPlatform Include="linux" />
		<SupportedPlatform Include="macos" />
	</ItemGroup>

</Project>
