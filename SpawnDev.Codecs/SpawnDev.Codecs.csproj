<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>0.1.0-alpha.1</Version>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.Codecs</Title>
		<Authors>LostBeard</Authors>
		<Description>Pure-.NET, ILGPU-accelerated, patent-clean audio and video codecs (Opus, VP8, VP9, AV1, FLAC, Vorbis). Runs on every ILGPU backend - CUDA, OpenCL, CPU, WebGPU, WebGL, Wasm. Desktop AND Blazor WebAssembly.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.Codecs</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.Codecs.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Codec;Audio;Video;Opus;VP8;VP9;AV1;FLAC;Vorbis;WebRTC;Blazor;BlazorWebAssembly;WebGPU;ILGPU;GPU;CrossPlatform</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="SpawnDev.ILGPU" Version="4.9.2-rc.12" />
	  <PackageReference Include="SpawnDev.EBML" Version="3.0.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- Test project sees internal types so SILK/CELT subsystems can be tested
		     in isolation without polluting the public API. -->
		<InternalsVisibleTo Include="SpawnDev.Codecs.Demo.Shared" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<SupportedPlatform Include="windows" />
		<SupportedPlatform Include="linux" />
		<SupportedPlatform Include="macos" />
	</ItemGroup>

</Project>
