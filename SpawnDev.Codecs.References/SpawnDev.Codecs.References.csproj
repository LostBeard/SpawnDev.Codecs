<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>0.3.0-rc.2</Version>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.Codecs.References</Title>
		<Authors>LostBeard</Authors>
		<Description>CPU reference implementations of the codecs that ship in SpawnDev.Codecs. Used for bit-exact verification of the GPU pairs and for development reference. Pulls in external pure-managed codec libraries (e.g. Concentus for Opus) which is why this project exists separately - SpawnDev.Codecs itself ships with ZERO external dependencies (only SpawnDev.* + Microsoft framework packages). Consumers who need only the GPU pairs reference SpawnDev.Codecs alone; consumers who want CPU references too reference both.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.Codecs</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.Codecs.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Codec;Audio;Video;Opus;VP8;VP9;AV1;FLAC;Vorbis;Reference;CPU;Blazor;BlazorWebAssembly</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SpawnDev.Codecs\SpawnDev.Codecs.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- BSD-3 pure-managed Opus port. Used by the CPU reference Opus
		     encoder + decoder for bit-exact verification of the GPU
		     OpusEncoderGpu + OpusDecoderGpu pair. Lives in this project
		     (References) instead of the main SpawnDev.Codecs library so
		     the main library ships zero external dependencies per the
		     architectural directive. -->
		<PackageReference Include="Concentus" Version="2.2.2" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SpawnDev.Codecs.Demo.Shared" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<SupportedPlatform Include="windows" />
		<SupportedPlatform Include="linux" />
		<SupportedPlatform Include="macos" />
	</ItemGroup>

</Project>
