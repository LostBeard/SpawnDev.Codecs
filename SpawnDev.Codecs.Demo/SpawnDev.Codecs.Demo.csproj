<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Disable IL trimming to preserve ILGPU kernel methods invoked via reflection -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Disable AOT compilation - ILGPU needs IL reflection to work -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- mark as testable by PlaywrightMultiTest -->
    <PlaywrightMultiTest>

    </PlaywrightMultiTest>
  </PropertyGroup>

  <!-- Inject build timestamp into assembly metadata so the app can print it to browser console -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTimestamp</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss")) UTC</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.4" PrivateAssets="all" />
    <PackageReference Include="SpawnDev.SpawnJS.Blazor" Version="3.0.7" />
    <PackageReference Include="SpawnDev.UnitTesting.Browser" Version="2.7.2-local.4" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="playwright-test.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="playwright-test.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep this pin equal to SpawnDev.Codecs.csproj's: a direct reference wins over the library's, so a stale pin here
         runs every browser lane (PlaywrightMultiTest) on the old ILGPU. -->
    <PackageReference Include="SpawnDev.ILGPU" Version="5.4.44" />
    <ProjectReference Include="..\SpawnDev.Codecs\SpawnDev.Codecs.csproj" />
    <ProjectReference Include="..\SpawnDev.Codecs.Demo.Shared\SpawnDev.Codecs.Demo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Temporary fix for dotnet/runtime#135090: a cached 503/404 boot file under force-cache bricks the app;
         this JS initializer retries such a fetch once with cache: reload. Remove when .NET fixes it. -->
    <PackageReference Include="SpawnDev.Blazor.BootRecovery" Version="1.0.0" />
  </ItemGroup>

</Project>
