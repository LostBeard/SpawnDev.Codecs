<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.UnitTesting.Blazor" Version="2.4.2" />
		<!-- Test-only oracle: pure-C# BSD-3 port of libopus. Used ONLY in tests to
		     generate reference Opus bitstreams and to cross-validate our decoder
		     output bit-exactly. The SpawnDev.Codecs library itself has no Concentus
		     dependency; this reference lives in the test project. BSD-3 attribution
		     in NOTICE.md. -->
		<PackageReference Include="Concentus" Version="2.2.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SpawnDev.Codecs\SpawnDev.Codecs.csproj" />
	</ItemGroup>

	<!-- Bundled real-world container test fixtures. Embedded as resources
	     so the same asset is reachable from desktop DemoConsole runs AND
	     Blazor WASM in-browser runs without static-web-asset plumbing. -->
	<ItemGroup>
		<EmbeddedResource Include="TestData\Big_Buck_Bunny_180_10s.webm" />
		<!-- ffmpeg-decoded ground truth for the first frame of the BBB
		     fixture. Generated with:
		         ffmpeg -i Big_Buck_Bunny_180_10s.webm -vframes 1 \
		                -f rawvideo -pix_fmt yuv420p bbb_first_frame.yuv
		     Layout: 320x180 yuv420p planar = 86400 bytes
		         [0..57599]      : Y plane (320x180)
		         [57600..71999]  : U plane (160x90)
		         [72000..86399]  : V plane (160x90)
		     Used by Vp9Decoder integration tests to compare our decoder's
		     output against ffmpeg's reference. -->
		<EmbeddedResource Include="TestData\bbb_first_frame.yuv" />
	</ItemGroup>

</Project>
