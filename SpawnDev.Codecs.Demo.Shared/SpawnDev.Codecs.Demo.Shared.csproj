<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.UnitTesting.Blazor" Version="2.4.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SpawnDev.Codecs\SpawnDev.Codecs.csproj" />
		<!-- Tests use the CPU reference encoders/decoders (e.g. Concentus-based
		     OpusEncoder + OpusDecoder, ref FlacEncoder, ref Vorbis stack) as
		     bit-exact oracles for the GPU pairs. References transitively
		     brings Concentus, so no direct Concentus PackageReference here. -->
		<ProjectReference Include="..\SpawnDev.Codecs.References\SpawnDev.Codecs.References.csproj" />
	</ItemGroup>

	<!-- Bundled real-world container test fixtures. Embedded as resources
	     so the same asset is reachable from desktop DemoConsole runs AND
	     Blazor WASM in-browser runs without static-web-asset plumbing. -->
	<ItemGroup>
		<EmbeddedResource Include="TestData\Big_Buck_Bunny_180_10s.webm" />
		<!-- ffmpeg-decoded ground truth for the first frame of the BBB
		     fixture. Generated with:
		         ffmpeg -i Big_Buck_Bunny_180_10s.webm -vframes 1 \
		                -f rawvideo -pix_fmt yuv420p bbb_first_frame.yuv
		     Layout: 320x180 yuv420p planar = 86400 bytes
		         [0..57599]      : Y plane (320x180)
		         [57600..71999]  : U plane (160x90)
		         [72000..86399]  : V plane (160x90)
		     Used by Vp9Decoder integration tests to compare our decoder's
		     output against ffmpeg's reference. -->
		<EmbeddedResource Include="TestData\bbb_first_frame.yuv" />
		<!-- AV1 IVF test fixture: 320x180 60-frame 2-second AV1 stream
		     generated from BBB.webm with libaom-av1 cpu-used 8 b:v 200k.
		     Used by AV1 OBU parser + future Av1Decoder tests. -->
		<EmbeddedResource Include="TestData\bbb_180_2s.ivf" />
		<!-- ffmpeg AV1 ground-truth: first frame of bbb_180_2s.ivf decoded
		     by libdav1d / libaom-av1 to yuv420p. Same 320x180 86400-byte
		     layout as bbb_first_frame.yuv. Used by Av1KeyframeWalker tests
		     to compare decoded pixel mean vs the reference. -->
		<EmbeddedResource Include="TestData\bbb_av1_first_frame.yuv" />
	</ItemGroup>

</Project>
